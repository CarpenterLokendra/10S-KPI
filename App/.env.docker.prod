# Docker Production Environment Configuration
# ⚠️  SECURITY: Do NOT commit this file to git!
# Store secrets in secure environment management (AWS Secrets Manager, HashiCorp Vault, etc.)

# ============================================
# DATABASE (PostgreSQL)
# ============================================
# Use managed database service in production (AWS RDS, Azure Database, etc.)
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_SECURE_DB_PASSWORD
DB_NAME=10s_game_db
DB_PORT=5432

# ============================================
# ENVIRONMENT
# ============================================
ENVIRONMENT=production
SERVER_RELOAD=false
LOG_LEVEL=INFO

# ============================================
# FRONTEND
# ============================================
# Set to your actual domain
VITE_API_URL=https://api.yourdomain.com
VITE_WS_URL=wss://api.yourdomain.com

# ============================================
# BACKEND - SECURITY
# ============================================
# IMPORTANT: Generate a strong secret key!
# Run: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=YOUR_STRONG_SECRET_KEY_HERE
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================
# BACKEND - CORS
# ============================================
# Only allow your actual domain in production
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================
# BACKEND - GAME SETTINGS
# ============================================
TURN_TIMEOUT_SECONDS=30
DISCONNECTION_TIMEOUT_SECONDS=120
LOBBY_EXPIRY_SECONDS=180
CONSECUTIVE_ROUNDS_FOR_CATCH=2
CATCH_10S_MULTIPLIER=100

# ============================================
# BACKEND - OPTIONAL SERVICES
# ============================================
ENABLE_REDIS=true
REDIS_URL=redis://redis:6379/0
