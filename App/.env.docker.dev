# Docker Development Environment Configuration
# Copy to .env and update values for local development in Docker

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_PORT=5432

# ============================================
# ENVIRONMENT
# ============================================
ENVIRONMENT=development
SERVER_RELOAD=true
LOG_LEVEL=DEBUG

# ============================================
# FRONTEND
# ============================================
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# ============================================
# BACKEND - SECURITY (Change in production!)
# ============================================
JWT_SECRET_KEY=your_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================
# BACKEND - CORS
# ============================================
ALLOWED_ORIGINS=http://localhost:80,http://localhost:3000,http://localhost,http://frontend,http://localhost:8000

# ============================================
# BACKEND - GAME SETTINGS
# ============================================
TURN_TIMEOUT_SECONDS=30
DISCONNECTION_TIMEOUT_SECONDS=120
LOBBY_EXPIRY_SECONDS=180
CONSECUTIVE_ROUNDS_FOR_CATCH=2
CATCH_10S_MULTIPLIER=100

# ============================================
# BACKEND - OPTIONAL SERVICES (disabled by default)
# ============================================
ENABLE_REDIS=false
REDIS_URL=redis://redis:6379/0
