# 🔐 PRODUCTION ENVIRONMENT - CHANGE ALL VALUES!
# This is a template. Update each value before deploying.

# ============================================
# 🔒 CRITICAL SECRETS - MUST CHANGE
# ============================================

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_THIS_TO_STRONG_RANDOM_SECRET

# Use managed database (AWS RDS, Azure, Heroku)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://prod_user:STRONG_PASSWORD@prod-db.aws.rds.amazonaws.com:5432/10s_game

# ============================================
# 🌍 CORS - YOUR DOMAIN
# ============================================
ALLOWED_ORIGINS=https://yourgame.com,https://app.yourgame.com,https://www.yourgame.com

# ============================================
# 📋 SERVER CONFIGURATION
# ============================================
ENVIRONMENT=production
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SERVER_RELOAD=False
DEBUG=False

# ============================================
# 🔐 SECURITY
# ============================================
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=30
BCRYPT_ROUNDS=12

# ============================================
# 🗄️ DATABASE OPTIMIZATION
# ============================================
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE=3600

# ============================================
# 📊 LOGGING
# ============================================
LOG_LEVEL=WARNING
DEBUG=False

# ============================================
# 🔴 REQUIREMENTS CHECK
# ============================================
# ❌ DO NOT deploy unless:
# ✅ JWT_SECRET_KEY is changed from default
# ✅ DATABASE_URL uses strong password
# ✅ ALLOWED_ORIGINS is specific (not "*")
# ✅ SERVER_RELOAD is False
# ✅ ENVIRONMENT is "production"
# ✅ DEBUG is False
# ✅ Database backups are configured
# ✅ HTTPS/TLS is enabled (use reverse proxy)
# ✅ Security headers are enabled
# ✅ Rate limiting is enabled
# ✅ Monitoring & alerting is configured
